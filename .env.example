# MySpace AI — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit a .env file with real secrets.

NODE_ENV=development
PORT=3001

# REQUIRED: Set to a random 64-character hex string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server will refuse to start in production without a strong secret (< 32 chars = rejected).
JWT_SECRET=

STORAGE_DIR=./storage

# Seed the database with demo data on first run (development only).
# Set to "true" only when you want to populate a fresh dev DB with sample content.
SEED_DEMO=false

# ---------------------------------------------------------------------------
# AI Provider Configuration
# Supported providers: "openai", "gemini", "ollama"
# If AI_PROVIDER is not set or AI_API_KEY is empty, the system runs in
# "Search Mode" — real workspace content is surfaced but no LLM generation
# is performed. No fake/canned answers are ever shown.
# ---------------------------------------------------------------------------
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# For Ollama or OpenAI-compatible endpoints (e.g. Groq, Mistral, LM Studio):
AI_BASE_URL=

# Optional external PostgreSQL connection URL.
# If not set, a high-performance WAL-mode SQLite database is used automatically.
# DATABASE_URL=postgresql://user:password@localhost:5432/myspace_ai
