# MySpace AI Environment Configuration
NODE_ENV=development
PORT=3001
JWT_SECRET=myspace-ai-super-secret-production-key-2026-isolated
STORAGE_DIR=./storage

# AI Provider Configuration
# Supported providers: "local" (default offline semantic engine), "openai", "anthropic", "gemini", "ollama"
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Optional external PostgreSQL connection URL (if not set, high-performance WAL SQLite is used)
# DATABASE_URL=postgresql://user:password@localhost:5432/myspace_ai
